<?xml version="1.0" encoding="utf-8"?>
<!-- Sulanga: neon outline key (white stroke is tinted by the theme key color) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="1dp" android:insetRight="1dp" android:insetTop="1dp" android:insetBottom="1dp">
    <shape android:shape="rectangle">
        <solid android:color="#00000000" />
        <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
        <corners android:radius="10dp" />
    </shape>
</inset>
